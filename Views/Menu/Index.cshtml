@using WebApplication1.Models.ProductDTO
@model IEnumerable<ProductDTO>

@{
    ViewData["Title"] = "Menu";

    // Presentation only: derive categories from the products supplied by the controller.
    // All filtering decisions are handled in the controller/repository.
    var allCategories = Model
        .Select(p => p.CategoryName ?? "Uncategorized")
        .Distinct()
        .OrderBy(c => c)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Menu</h1>
        <p class="text-muted small mb-0">Seasonal selections, grouped by category for easy browsing.</p>
    </div>

    @* Admin actions: only visible to authenticated Admin users (no visible login link anywhere) *@
    @if (User.IsInRole("Admin"))
    {
        <div>
            <a class="btn btn-outline-secondary me-2" href="@Url.Action("Create", "Category")">Add Category</a>
            <a class="btn btn-accent" href="@Url.Action("Create", "Product")">Add Item</a>
        </div>
    }
</div>

@* Category filter pills (presentation only) - these call the controller helper that resolves name -> Id and redirects to the id-based filter *@
<div class="mb-4">
    <div class="d-flex gap-2 flex-row flex-nowrap overflow-auto py-1" role="tablist" aria-label="Category filters">
        <a role="tab"
           aria-pressed="@(ViewData["SelectedCategory"] == null ? "true" : "false")"
           class="btn btn-sm rounded-pill @(ViewData["SelectedCategory"] == null ? "btn-accent" : "btn-outline-dark")"
           href="@Url.Action("Index", "Menu")">
            All
        </a>

        @foreach (var cat in allCategories)
        {
            var isActive = ViewData["SelectedCategory"] != null && string.Equals(cat, (ViewData["SelectedCategory"] as string), StringComparison.OrdinalIgnoreCase);
            <a role="tab"
               aria-pressed="@(isActive.ToString().ToLower())"
               class="btn btn-sm rounded-pill @(isActive ? "btn-accent" : "btn-outline-dark")"
               href="@Url.Action("GetByCategoryName", "Menu", new { name = cat })">
                @cat
            </a>
        }
    </div>
    <small class="d-block text-muted mt-2">Tip: use these filters to quickly browse categories. (Admin controls shown only when signed in.)</small>
</div>

@* If controller provided SelectedCategory, optionally show back control. View is not responsible for determining filtering. *@
@if (ViewData["SelectedCategory"] is string selected && !string.IsNullOrEmpty(selected))
{
    <div class="mb-3">
        <a class="text-muted" href="@Url.Action("Index", "Menu")">&larr; Back to full menu</a>
    </div>
}

@* Group and display the products provided by the controller. The view treats the model as the source of truth. *@
@foreach (var cat in allCategories)
{
    var productsInCategory = Model.Where(p => (p.CategoryName ?? "Uncategorized").Equals(cat, StringComparison.OrdinalIgnoreCase)).ToList();
    <section class="mb-5 reveal" id="category-@cat.Replace(" ", "-")">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h2 class="mb-1">@cat</h2>
                <p class="text-muted small mb-0">
                    @{
                        var sampleDesc = productsInCategory.Any()
                        ? $"{productsInCategory.Count} handcrafted {(productsInCategory.Count == 1 ? "item" : "items")} showcasing the best of {cat.ToLower()}."
                        : "No items yet — check back soon for seasonal additions.";
                    }
                    @sampleDesc
                </p>
            </div>

            <div class="text-end">
                <a class="btn btn-outline-dark" href="@Url.Action("Index", "Menu")#category-@cat.Replace(" ", "-")">Jump</a>
            </div>
        </div>

        @if (!productsInCategory.Any())
        {
            <div class="p-4 menu-card text-center text-muted">No items in this category yet.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in productsInCategory)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="dish-card reveal h-100">
                            <a href="@Url.Action("Details", "Menu", new { id = item.Id })" style="text-decoration:none;color:inherit;">
                                <img src="@Url.Content($"~/products/{item.ImageFileName}")" alt="@item.Name" loading="lazy" />
                                <div class="card-body">
                                    <div>
                                        <h5 style="margin-bottom:.25rem;">@item.Name</h5>
                                        <div class="text-muted small mb-2">@item.Description</div>
                                    </div>

                                    <div class="meta">
                                        <div class="d-flex gap-2">
                                            @if (item.Variants != null && item.Variants.Any())
                                            {
                                                foreach (var v in item.Variants.Take(2))
                                                {
                                                    var tag = v.Name?.ToLowerInvariant() ?? "";
                                                    if (tag.Contains("spicy"))
                                                    {
                                                        <span class="tag">Spicy</span>
                                                    }
                                                    else if (tag.Contains("veg") || tag.Contains("veget"))
                                                    {
                                                        <span class="tag">Vegetarian</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="tag" style="background: rgba(11,11,11,0.04); color:var(--ink);">@v.Name</span>
                                                    }
                                                }
                                            }
                                        </div>

                                        <div class="text-end">
                                            <div class="price">
                                                @(item.Variants != null && item.Variants.Any() ? item.Variants.Min(v => v.Price).ToString("C") : "$0.00")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3 d-flex justify-content-between align-items-center">
                                        <a class="btn btn-outline-dark btn-sm" href="@Url.Action("Details", "Menu", new { id = item.Id })">Details</a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="btn-group">
                                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Update", "Menu", new { id = item.Id })">Edit</a>
                                                <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", "Menu", new { id = item.Id })" onclick="return confirm('Delete this item?');">Delete</a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}