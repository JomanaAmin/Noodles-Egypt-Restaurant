@using WebApplication1.Models.ProductDTO
@model CreateProductDTO

<h2>Create New Product</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="row mb-3">
        <label class="col-sm-2">Name</label>
        <div class="col-sm-10"><input asp-for="Name" class="form-control" required /></div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2">Category</label>
        <div class="col-sm-10">
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
        </div>
    </div>

    <hr />
    <h4>Variants</h4>
    <div id="variants-container">
        @await Html.PartialAsync("_ProductVariantRow", new CreateProductVariantDTO(), new ViewDataDictionary(ViewData) { { "index", 0 } })
    </div>

    <button type="button" id="add-variant-btn" class="btn btn-secondary mt-2">+ Add Variant</button>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create Product</button>
    </div>
</form>

@section Scripts {
    <script>
        let variantIndex = 1;

        // AJAX Event Listener
        document.getElementById('add-variant-btn').addEventListener('click', function () {
            fetch(`/Products/GetVariantRow?index=${variantIndex}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('variants-container').insertAdjacentHTML('beforeend', html);
                    variantIndex++;
                });
        });

        // Remove row function
        function removeRow(btn) {
            btn.closest('.variant-row').remove();
        }
    </script>
}