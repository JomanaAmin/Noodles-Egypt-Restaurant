@using WebApplication1.Data.Entities
@model List<Category>
<h2>Categories</h2>
<table>
    <thead>
        <th>Name</th>
        <th>Description</th>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td><img src="/categories/@category.ImageFileName" width="100"/></td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a class="btn btn-primary btn-sm" asp-controller="Category" asp-action="Update"
                        asp-route-id="@category.Id">Edit</a> 
                        <a class="btn btn-primary btn-sm" asp-controller="Category" asp-action="Delete"
                        asp-route-id="@category.Id">Delete</a>
                    </td>
                }
            </tr>
            
        }
    </tbody>
</table>