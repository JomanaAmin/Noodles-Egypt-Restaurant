@using WebApplication1.Data.Entities
@model Category

<h2>Details for @Model.Name</h2>

<div>
    <div class="row mb-3">
        <label class="col-sm-4 col-form-label fw-bold">Name</label>
        <div class="col-sm-8 pt-2">
            @Model.Name
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-form-label fw-bold">Description</label>
        <div class="col-sm-8 pt-2">
            @Model.Description
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-form-label fw-bold">Image</label>
        <div class="col-sm-8">
            <img src="/categories/@Model.ImageFileName" width="150" class="img-thumbnail" />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-sm-8 offset-sm-4">
            <a class="btn btn-primary" asp-controller="Category" asp-action="Index">Back to List</a>
        </div>
    </div>
</div>