@using WebApplication1.Models.ProductDTO
@model CreateProductVariantDTO

<div class="variant border rounded p-3 mb-3">

    <div class="mb-2">
        <label>Name</label>
        <input asp-for="Name"
               class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>

    </div>

    <div class="mb-2">
        <label>Description</label>
        <input asp-for="Description"
               class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>

    </div>

    <div class="mb-2">
        <label>Price</label>
        <input asp-for="Price"
               type="number"
               step="0.01"
               class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>

    </div>

    <button type="button" class="btn btn-outline-danger btn-sm removeVariant mt-2">
        <i class="bi bi-trash"></i> Delete Variant
    </button>

</div>