@using WebApplication1.Models.ProductDTO
@model ProductDTO

@{
    ViewData["Title"] = Model?.Name ?? "Product";
}

<div class="container-lg py-5">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-0">@Model.Name</h1>
            <div class="text-muted small">@Model.CategoryName</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-dark" href="@Url.Action("Index", "Menu")">Back to Menu</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-accent" href="@Url.Action("Update", "Menu", new { id = Model.Id })">Edit</a>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="dish-card">
                <div class="ratio ratio-4x3">
                    <img src="@Url.Content($"~/products/{Model.ImageFileName}")" alt="@Model.Name" class="w-100 h-100" style="object-fit:cover;">
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-section">
                <h3 class="mb-2">@Model.Name</h3>
                <p class="text-muted">@Model.Description</p>

                <div class="mt-3">
                    <strong>Variants & Prices</strong>
                    @if (Model.Variants != null && Model.Variants.Any())
                    {
                        <ul class="list-unstyled mt-2">
                            @foreach (var v in Model.Variants)
                            {
                                <li class="d-flex justify-content-between py-2 border-bottom" style="border-color: rgba(0,0,0,0.04);">
                                    <div>
                                        <strong>@v.Name</strong>
                                        <div class="small text-muted">@v.Description</div>
                                    </div>
                                    <div class="text-end">@v.Price.ToString("C")</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted small">No variants available.</div>
                    }
                </div>

                <div class="mt-4 d-flex gap-2">
                    <a class="btn btn-outline-dark" href="@Url.Action("Index", "Menu")">View Menu</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-danger" href="@Url.Action("Delete", "Menu", new { id = Model.Id })">Delete</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>