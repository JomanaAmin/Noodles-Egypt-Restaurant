@using WebApplication1.Models.ProductDTO
@model UpdateProductDTO

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="container-lg py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Edit Item</h1>
            <p class="text-muted small mb-0">Modify the product details below.</p>
        </div>
        <a class="btn btn-outline-dark" href="@Url.Action("Index", "Menu")">Back</a>
    </div>

    <form asp-action="Update" asp-controller="Menu" method="post" enctype="multipart/form-data" class="form-section">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control rounded-pill" placeholder="Name" />
                    <label asp-for="Name">Name</label>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <textarea asp-for="Description" class="form-control rounded" placeholder="Description" style="height:120px"></textarea>
                    <label asp-for="Description">Description</label>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6 form-floating">
                        <select asp-for="CategoryId" class="form-select rounded-pill" asp-items="ViewBag.Categories"></select>
                        <label asp-for="CategoryId">Category</label>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Replace Image</label>
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control rounded-pill" name="ImageFile" />
                    </div>
                </div>

                <h5 class="mt-3">Variants</h5>
                <div id="variantsList">
                    @for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="card mb-3 p-3 variant-item position-relative" data-index="@i">
                            <button type="button" class="btn btn-danger btn-sm remove-variant shadow-sm" style="position:absolute; right:12px; top:12px; z-index:10; border-radius:50%; width:30px; height:30px; display:flex; align-items:center; justify-content:center;" aria-label="Remove variant">&times;</button>                            <div class="row g-2">
                                <div class="col-md-5 form-floating">
                                    <input name="Variants[@i].Name" value="@Model.Variants[i].Name" class="form-control rounded-pill" placeholder="Variant name" />
                                    <label>Variant name</label>
                                    <input type="hidden" name="Variants[@i].Id" value="@Model.Variants[i].Id" />
                                </div>
                                <div class="col-md-3 form-floating">
                                    <input name="Variants[@i].Price" value="@Model.Variants[i].Price" class="form-control rounded-pill" placeholder="Price" />
                                    <label>Price</label>
                                </div>
                                <div class="col-md-4 form-floating">
                                    <input name="Variants[@i].Description" value="@Model.Variants[i].Description" class="form-control rounded-pill" placeholder="Description" />
                                    <label>Description</label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button id="addVariantBtn" type="button" class="btn btn-outline-dark">+ Add Variant</button>
                    <small class="text-muted align-self-center">Removing a variant will delete it on save.</small>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="menu-card p-3 text-center">
                    <img id="currentImg" src="@Url.Content($"~/products/{Model.ImageFileName}")" alt="current image" class="img-fluid rounded" style="height:180px; object-fit:cover" />
                    <div class="mt-2 text-muted small">Current image</div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-accent w-100">Save Changes</button>
                    <a class="btn btn-outline-secondary w-100 mt-2" href="@Url.Action("Index", "Menu")">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const addBtn = document.getElementById('addVariantBtn');
            const list = document.getElementById('variantsList');

            function reindex() {
                const items = list.querySelectorAll('.variant-item');
                items.forEach((it, idx) => {
                    it.setAttribute('data-index', idx);
                    it.querySelectorAll('input').forEach(inp => {
                        const name = inp.getAttribute('name') || '';
                        const newName = name.replace(/Variants\[\d+\]/, `Variants[${idx}]`);
                        inp.setAttribute('name', newName);
                    });
                });
            }

            function bindRemove(btn) {
                btn.addEventListener('click', function (ev) {
                    ev.preventDefault();
                    if (!confirm('Are you sure you want to remove this variant?')) return;
                    const item = btn.closest('.variant-item');
                    if (!item) return;
                    item.remove();
                    reindex();
                });
            }

            // Bind existing circular remove buttons
            document.querySelectorAll('button[aria-label="Remove variant"]').forEach(bindRemove);

            // Add variant handler
            addBtn.addEventListener('click', function () {
                const idx = list.querySelectorAll('.variant-item').length;
                const card = document.createElement('div');
                card.className = 'card mb-3 p-3 variant-item position-relative';
                card.setAttribute('data-index', idx);
                card.innerHTML = `
                    <button type="button" class="btn remove-variant" style="position:absolute; right:10px; top:10px; width:32px; height:32px; padding:0; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.0rem;" aria-label="Remove variant">&times;</button>
                    <div class="row g-2">
                        <div class="col-md-5 form-floating">
                            <input name="Variants[${idx}].Name" class="form-control rounded-pill" placeholder="Variant name" />
                            <label>Variant name</label>
                        </div>
                        <div class="col-md-3 form-floating">
                            <input name="Variants[${idx}].Price" class="form-control rounded-pill" placeholder="Price" />
                            <label>Price</label>
                        </div>
                        <div class="col-md-4 form-floating">
                            <input name="Variants[${idx}].Description" class="form-control rounded-pill" placeholder="Description" />
                            <label>Description</label>
                        </div>
                    </div>`;
                list.appendChild(card);
                bindRemove(card.querySelector('button[aria-label="Remove variant"]'));
            });

            // Image preview for Update (currentImg)
            const imageInput = document.querySelector('input[type=file][name="ImageFile"]');
            const previewCurrent = document.getElementById('currentImg');
            if (imageInput && previewCurrent) {
                imageInput.addEventListener('change', function (ev) {
                    const f = ev.target.files && ev.target.files[0];
                    if (!f) return;
                    const reader = new FileReader();
                    reader.onload = function (e) { previewCurrent.src = e.target.result; };
                    reader.readAsDataURL(f);
                });
            }
        })();
    </script>
}